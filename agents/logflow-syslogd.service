[Unit]
Description=LogFlow — récepteur syslog réseau (Synology/NAS & équipements)
After=network.target mariadb.service mysql.service
Wants=network.target

[Service]
Type=simple
# Adaptez le chemin si votre installation diffère de /var/www/logflow
ExecStart=/usr/bin/php /var/www/logflow/syslogd.php
Restart=always
RestartSec=3
User=www-data
Group=www-data

# Le port par défaut (1514) ne nécessite aucun privilège.
# Pour écouter sur le port standard 514 (<1024) sans lancer en root,
# décommentez les deux lignes suivantes :
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# Environment=SYSLOG_PORT=514

# Durcissement basique
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
